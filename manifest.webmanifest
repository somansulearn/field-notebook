{
  "name": "जनगणना फील्ड नोटबुक",
  "short_name": "फील्ड नोटबुक",
  "description": "जनगणना 2027 प्रगणकों के लिए ऑफलाइन नोटबुक (आधिकारिक ऐप नहीं)",
  "lang": "hi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f2ec",
  "theme_color": "#0b4a8b",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            ".txt",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  }
}